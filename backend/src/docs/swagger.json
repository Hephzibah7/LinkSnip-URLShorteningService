{
  "openapi": "3.0.3",
  "info": {
    "title": "LinkSnip API",
    "version": "1.0.0",
    "description": "High-performance URL Shortener, Custom Alias Management, and Real-Time Click Analytics Engine REST API."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "Link": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "clx123456789" },
          "originalUrl": { "type": "string", "example": "https://example.com/very-long-product-page" },
          "shortCode": { "type": "string", "example": "aB3k91" },
          "customAlias": { "type": "string", "nullable": true, "example": "summer-sale" },
          "shortUrl": { "type": "string", "example": "http://localhost:4000/summer-sale" },
          "title": { "type": "string", "example": "Summer Campaign 2026" },
          "redirectType": { "type": "integer", "example": 302 },
          "clickCount": { "type": "integer", "example": 42 },
          "maxClicks": { "type": "integer", "nullable": true, "example": 500 },
          "expiresAt": { "type": "string", "format": "date-time", "nullable": true },
          "isPasswordProtected": { "type": "boolean", "example": false },
          "isActive": { "type": "boolean", "example": true },
          "qrDataUrl": { "type": "string", "description": "Base64 PNG data URL" }
        }
      },
      "CreateLinkRequest": {
        "type": "object",
        "required": ["originalUrl"],
        "properties": {
          "originalUrl": { "type": "string", "example": "https://example.com/my-article" },
          "title": { "type": "string", "example": "My Blog Article" },
          "customAlias": { "type": "string", "example": "my-article" },
          "password": { "type": "string", "example": "secret123" },
          "redirectType": { "type": "integer", "enum": [301, 302], "default": 302 },
          "expiresAt": { "type": "string", "format": "date-time" },
          "maxClicks": { "type": "integer", "example": 100 },
          "folderId": { "type": "string" },
          "tagIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "paths": {
    "/api/v1/links": {
      "post": {
        "summary": "Create a short link",
        "description": "Shorten a URL with optional alias, password protection, and expiration. Open to guests and authenticated users.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateLinkRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Short link created successfully" },
          "400": { "description": "Validation error or malicious URL detected" }
        }
      },
      "get": {
        "summary": "List user's links",
        "security": [{ "BearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "expired", "disabled", "all"] } },
          { "name": "folderId", "in": "query", "schema": { "type": "string" } },
          { "name": "tagId", "in": "query", "schema": { "type": "string" } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["createdAt", "clickCount", "title", "expiresAt"] } },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "List of user links" }
        }
      }
    },
    "/api/v1/links/{id}": {
      "get": {
        "summary": "Get link details",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Link details and QR code" },
          "404": { "description": "Link not found" }
        }
      },
      "patch": {
        "summary": "Update link settings",
        "security": [{ "BearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Link updated" }
        }
      },
      "delete": {
        "summary": "Delete link",
        "security": [{ "BearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Link deleted" }
        }
      }
    },
    "/api/v1/links/bulk": {
      "post": {
        "summary": "Bulk create links via CSV file",
        "security": [{ "BearerAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": {
          "200": { "description": "Bulk import status and results" }
        }
      }
    },
    "/api/v1/analytics/{linkId}": {
      "get": {
        "summary": "Get detailed analytics for a link",
        "parameters": [{ "name": "linkId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Clicks over time, top referrers, geo breakdown, device & browser stats" }
        }
      }
    },
    "/api/v1/analytics/{linkId}/export": {
      "get": {
        "summary": "Export click event logs as CSV",
        "parameters": [{ "name": "linkId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "CSV stream download" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a new user",
        "responses": { "201": { "description": "User created and JWT token returned" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "responses": { "200": { "description": "JWT session token returned" } }
      }
    },
    "/{slug}": {
      "get": {
        "summary": "Resolve short code / alias redirect",
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "301": { "description": "Permanent Redirect" },
          "302": { "description": "Temporary Redirect" }
        }
      }
    }
  }
}
